# ============================================
# FleetFlow Environment Configuration
# ============================================

# Database - PostgreSQL + PostGIS
DATABASE_URL="postgresql://fleetflow:fleetflow_dev@localhost:5432/fleetflow"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fleetflow
POSTGRES_PASSWORD=fleetflow_dev
POSTGRES_DB=fleetflow

# TimescaleDB
TIMESCALE_URL="postgresql://fleetflow:fleetflow_dev@localhost:5433/timescale"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB
MONGODB_URL="mongodb://fleetflow:fleetflow_dev@localhost:27017/fleetflow?authSource=admin"

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER_URL=localhost:9092

# API Security (Optional)
API_KEY=
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
WEBSOCKET_BROADCAST_TOKEN=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-here-change-in-production

# External APIs (Optional - for production)
OSRM_API_URL=http://localhost:5000
TOMTOM_API_KEY=your_tomtom_api_key_here
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# MapLibre (Free - no API key needed)
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_key_for_premium_tiles

# Feature Flags
ENABLE_MOCK_DATA=true
ENABLE_WEBSOCKET=true
