# ===========================================
# FleetFlow Backend - Production Configuration
# ===========================================
# Copy this file to .env and fill in values

# Application
APP_NAME=FleetFlow API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
API_KEY=

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fleetflow
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=fleetflow

# TimescaleDB (for time-series data)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=timescale

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=fleetflow-api

# Security (REQUIRED - Generate a strong key!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY_AT_LEAST_32_CHARS

# Monitoring (Optional but recommended)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# External APIs (Optional)
TOMTOM_API_KEY=
OPENWEATHER_API_KEY=
OSRM_API_URL=http://router.project-osrm.org

# Feature Flags
ENABLE_MOCK_DATA=false
ENABLE_WEBSOCKET=true
