# FleetFlow WebSocket Server Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Create non-root user
RUN groupadd -r fleetflow && useradd -r -g fleetflow fleetflow

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for WebSocket server
RUN pip install --no-cache-dir \
    fastapi>=0.109.0 \
    uvicorn[standard]>=0.27.0 \
    structlog>=24.1.0 \
    redis>=5.0.1 \
    websockets>=12.0

# Copy WebSocket server code
COPY src/websocket_server.py ./src/websocket_server.py

# Set ownership
RUN chown -R fleetflow:fleetflow /app

USER fleetflow

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8002/health')" || exit 1

EXPOSE 8002

CMD ["uvicorn", "src.websocket_server:app", "--host", "0.0.0.0", "--port", "8002"]
