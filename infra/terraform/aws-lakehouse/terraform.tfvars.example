# COPY PRIVATELY: terraform.tfvars is ignored and must not enter git.
aws_account_id = "123456789012" # REPLACE AFTER HUMAN OWNER REVIEW
aws_region     = "eu-west-2"
resource_prefix = "fleetflow-review"

# Fail-closed: real planning/apply is blocked by default.
# Set true ONLY AFTER your AWS account, budget, IAM and cost review.
owner_approved = false

raw_retention_days     = 7
clean_retention_days   = 30
curated_retention_days = 90

# Optional account-wide budget alert; email must be supplied privately.
enable_budget_alert = false
# budget_alert_email = "you@example.com"

# Optional ONLY if account already has GitHub OIDC provider configured.
enable_github_oidc_audit_role = false
