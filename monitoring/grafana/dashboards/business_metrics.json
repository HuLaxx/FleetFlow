{
  "dashboard": {
    "title": "FleetFlow - Business Metrics",
    "panels": [
      {
        "title": "Orders Created Rate",
        "targets": [
          {
            "expr": "rate(orders_total[5m])",
            "legendFormat": "{{status}}"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Routes Optimized",
        "targets": [
          {
            "expr": "routes_optimized_total"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Optimization Duration",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(optimization_duration_seconds_bucket[5m]))"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Active Drivers",
        "targets": [
          {
            "expr": "active_drivers",
            "legendFormat": "{{status}}"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Active Vehicles",
        "targets": [
          {
            "expr": "active_vehicles",
            "legendFormat": "{{status}}"
          }
        ],
        "type": "stat"
      }
    ]
  }
}
